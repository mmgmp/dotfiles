spawn-sh-at-startup "$XDG_DATA_HOME/backgrounds/bg-setup.sh"
spawn-sh-at-startup "udiskie -t"

spawn-at-startup "swayidle" "-w" \
    "timeout" "300" "super-swaylock" \
    "timeout" "600" "niri msg action power-off-monitors"

spawn-sh-at-startup "gammastep -O 4500"
spawn-sh-at-startup "~/.local/share/appimages/tutanota-desktop-linux.AppImage -a"
