#---- GENERAL ----#

set hidden true
set ignorecase true
set icons true
set drawbox true
set sixel true
set previewer ~/.config/lf/previewer
set cursorpreviewfmt "\033[7m"
set ifs "\n"

#---- CONFIGURACIÓN DE TECLAS ----#

# Quitar teclas predeterminadas
map m
map n
map r
map t

# Renombrar
map A :rename; cmd-end
map I :rename; cmd-home

map . set hidden!

map md mkdir
map mf mkfile
map S symbolic
map C compress
map X trash
map E extract
map N copy-name
map P copy-path
map mo chmod

#---- COMANDOS ----#

# Crear carpeta
cmd mkdir %printf " Nombre del directorio: "; read ans; mkdir "$ans"; printf " "

# Crear archivo
cmd mkfile %printf " Nombre del archivo: "; read ans; touch "$ans"; printf " "

# Crear link simbólico
cmd symbolic %current_path=$(pwd); name=$(basename "$f"); ln -s "$f" "$current_path/Enlace_a_$name"

# Mover a la papelera
cmd trash %trash-put -- $fx

# Comprimir archivos
cmd compress %printf " Nombre del archivo comprimido: "; read ans; 7z a "$ans".7z $fs; printf " "

# Extraer en una carpeta
cmd extract ${{
	clear
	dir=$(basename "$f" | sed 's/\(.*\)\..*/\1/')
	7z x "$f" -o"$dir"
}}

# Abrir archivos
cmd open ${{
	case $(file --mime-type -Lb "$f") in
		text/*) $EDITOR "$f";;
		image/*) swayimg "$f";;
		audio/*) mpv --force-window "$f";;
		video/*) mpv --force-window "$f";;
		*/pdf) zathura "$f";;
		*) xdg-open "$f";;
	esac
}}

# Copiar nombre del archivo
cmd copy-name $basename "$f" | wl-copy -n && lf -remote "send $id echo 'Nombre del archivo copiado'"

# Copiar ruta del archivo
cmd copy-path $wl-copy -n "$f" && lf -remote "send $id echo 'Ruta del archivo copiada'"

# Ejecutar chmod con el argumento escrito
cmd chmod %printf " Argumento para chmod: "; read ans; chmod "$ans" $fx; printf " "
