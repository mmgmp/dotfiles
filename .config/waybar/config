{
	"height": 30,
	"margin-top": 5,
	"margin-left": 5,
	"margin-right": 5,
	"layer": "top",

	"modules-left": ["niri/workspaces"],
	"modules-center": ["clock"],
	"modules-right": ["tray", "pulseaudio", "battery", "idle_inhibitor"],

	"clock": {
		"format": "{:%e %b %H:%M}",
        "tooltip": false,
	},
    "tray": {
        "spacing": 14,
    },
	"niri/workspaces": {
		"format": "{value}",
	},
	"idle_inhibitor": {
		"format": "{icon}",
		"format-icons": {
			"activated": " ",
			"deactivated": "<span color='#808080'> </span>",
		},
	},
	"pulseaudio": {
		"format": "  {volume}%",
		"format-muted": "<span color='#808080'>  {volume}%</span>",
        "tooltip": false,
		"on-scroll-up": "volumecontrol up",
		"on-scroll-down": "volumecontrol down",
		"on-click": "pavucontrol",
		"on-click-right": "volumecontrol mute",
	},
}
